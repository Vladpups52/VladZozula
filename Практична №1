<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Реєстрація на спортивний захід</title>
</head>

<body>

    <h1>Реєстрація на спортивний захід</h1>

    <form>

        <!-- Ім'я -->
        <label for="name">Ім'я:</label>
        <input type="text" id="name" name="name" required>

        <br><br>

        <!-- Прізвище -->
        <label for="surname">Прізвище:</label>
        <input type="text" id="surname" name="surname" required>

        <br><br>

        <!-- Електронна пошта -->
        <label for="email">Електронна пошта:</label>
        <input type="email" id="email" name="email" required>

        <br><br>

        <!-- Номер телефону -->
        <label for="phone">Номер телефону:</label>
        <input type="tel" id="phone" name="phone">

        <br><br>

        <!-- Вік -->
        <label for="age">Вік:</label>
        <input type="number" id="age" name="age" min="12" max="80" required>

        <br><br>

        <!-- Дата участі -->
        <label for="date">Дата участі:</label>
        <input type="date" id="date" name="date" required>

        <br><br>

        <!-- Вибір дистанції -->
        <fieldset>
            <legend>Оберіть дистанцію:</legend>

            <input type="radio" id="distance2" name="distance" value="2 км" required>
            <label for="distance2">2 км</label>

            <br>

            <input type="radio" id="distance5" name="distance" value="5 км">
            <label for="distance5">5 км</label>

            <br>

            <input type="radio" id="distance10" name="distance" value="10 км">
            <label for="distance10">10 км</label>
        </fieldset>

        <br>

        <!-- Додаткові можливості -->
        <fieldset>
            <legend>Додаткові можливості:</legend>

            <input type="checkbox" id="shirt" name="options" value="Футболка">
            <label for="shirt">Отримати футболку</label>

            <br>

            <input type="checkbox" id="medal" name="options" value="Медаль">
            <label for="medal">Отримати медаль</label>

            <br>

            <input type="checkbox" id="news" name="options" value="Новини">
            <label for="news">Отримувати новини про наступні заходи</label>

            <br>

            <input type="checkbox" id="rating" name="options" value="Рейтинг">
            <label for="rating">Додати результати до загального рейтингу</label>
        </fieldset>

        <br>

        <!-- Категорія учасника -->
        <label for="category">Категорія учасника:</label>

        <select id="category" name="category" required>
            <option value="">-- Оберіть категорію --</option>
            <option value="student">Учень</option>
            <option value="school_student">Студент</option>
            <option value="adult">Дорослий</option>
            <option value="other">Інша категорія</option>
        </select>

        <br><br>

        <!-- Додаткова інформація -->
        <label for="info">
            <strong>Додаткова інформація для організаторів:</strong>
        </label>

        <br>

        <textarea
            id="info"
            name="info"
            rows="5"
            cols="40"
            placeholder="Введіть додаткову інформацію..."
        ></textarea>

        <br><br>

        <!-- Кнопки -->
        <button type="submit">Зареєструватися</button>
        <button type="reset">Очистити форму</button>

    </form>

</body>
</html>
