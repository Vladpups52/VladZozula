console.log('Очікувано: "null" | Факт:', String(null));
console.log('Очікувано: "105" | Факт:', "10" + 5);
console.log('Очікувано: 5 | Факт:', "10" - 5);
console.log('Очікувано: "object" | Факт:', typeof null);
